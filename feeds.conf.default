# Keep the two core feeds pinned to revisions known to match this Linux 5.4
# buildroot. Tracking the moving branches eventually pulls in package
# metadata for newer kernels/toolchains (for example golang1.26 and newer
# kmod names), which makes otherwise unrelated packages fail dependency
# validation.
src-git packages https://github.com/immortalwrt/packages.git^a517d8d69255f42f57efa95c41ba9db4022beb79
src-git luci https://github.com/immortalwrt/luci.git^8ceae5a1701eddbf084689185239847e69c39ac1
src-git routing https://github.com/openwrt/routing.git;openwrt-23.05
src-git telephony https://github.com/openwrt/telephony.git;openwrt-23.05
src-git-full modem https://github.com/ZJJCKA/5G-Modem-Support
src-git qmodem https://github.com/FUjr/modem_feeds.git;main
src-git istore https://github.com/linkease/istore;main
