#!/bin/sh /etc/rc.common

# Enable the BPI-R3 Mini LTE LED by cycling CFUN on a TD Tech MT5700M-CN.
# The operation is limited to this board and USB modem and runs once per boot.

START=99
STOP=15
USE_PROCD=1
EXTRA_COMMANDS="run_worker"

SERVICE_TAG="sendat-cfun"
DONE_FILE="/tmp/sendat-cfun.done"
READY_FILE="/tmp/sendat-cfun.ready"
MAX_WAIT=120

log_message()
{
	local priority="$1"
	shift
	logger -t "${SERVICE_TAG}" -p "daemon.${priority}" -- "$*"
}

is_bpi_r3_mini()
{
	local board_info

	board_info="$({
		cat /tmp/sysinfo/board_name 2>/dev/null
		cat /tmp/sysinfo/model 2>/dev/null
		tr '\000' ' ' < /proc/device-tree/model 2>/dev/null
	} | tr 'A-Z_' 'a-z-')"

	echo "${board_info}" | grep -qiE 'bpi[- ]?r3[- ]?mini'
}

is_mt5700_present()
{
	local device vendor product

	for device in /sys/bus/usb/devices/*; do
		[ -r "${device}/idVendor" ] || continue
		[ -r "${device}/idProduct" ] || continue

		vendor="$(cat "${device}/idVendor" 2>/dev/null)"
		product="$(cat "${device}/idProduct" 2>/dev/null)"
		[ "${vendor}:${product}" = "3466:3301" ] && return 0
	done

	return 1
}

find_mt5700_at_port()
{
	local section modem_name manufacturer at_port tty_class

	for section in $(uci -q show modem 2>/dev/null | sed -n \
		-e "s/^modem\.\([^.=]*\)='modem-device'$/\1/p" \
		-e "s/^modem\.\([^.=]*\)=modem-device$/\1/p"); do
		modem_name="$(uci -q get "modem.${section}.name" | tr 'A-Z' 'a-z')"
		manufacturer="$(uci -q get "modem.${section}.manufacturer" | tr 'A-Z' 'a-z')"
		at_port="$(uci -q get "modem.${section}.at_port")"

		if [ -c "${at_port}" ] && tty_belongs_to_mt5700 "${at_port}" && at_port_responds "${at_port}"; then
			case "${modem_name}:${manufacturer}" in
				*mt5700*:tdtech|unknown:unknown|:)
					echo "${at_port}"
					return 0
					;;
			esac
		fi
	done

	# UCI can lag behind tty hotplug. Discover only ports whose USB ancestor is
	# exactly 3466:3301, then require a real AT response before using one.
	for tty_class in /sys/class/tty/ttyUSB*; do
		[ -e "${tty_class}" ] || continue
		at_port="/dev/$(basename "${tty_class}")"
		[ -c "${at_port}" ] || continue
		tty_belongs_to_mt5700 "${at_port}" || continue
		at_port_responds "${at_port}" || continue
		echo "${at_port}"
		return 0
	done

	return 1
}

tty_belongs_to_mt5700()
{
	local tty_name path vendor product
	tty_name="$(basename "$1")"
	path="$(readlink -f "/sys/class/tty/${tty_name}/device" 2>/dev/null)"

	while [ -n "${path}" ] && [ "${path}" != "/" ]; do
		if [ -r "${path}/idVendor" ] && [ -r "${path}/idProduct" ]; then
			vendor="$(cat "${path}/idVendor" 2>/dev/null)"
			product="$(cat "${path}/idProduct" 2>/dev/null)"
			[ "${vendor}:${product}" = "3466:3301" ]
			return $?
		fi
		path="$(dirname "${path}")"
	done
	return 1
}

at_port_responds()
{
	local at_port="$1"
	local port_number response
	case "${at_port}" in
		/dev/ttyUSB[0-9]*) port_number="${at_port#/dev/ttyUSB}" ;;
		*) return 1 ;;
	esac
	response="$(timeout 2 sendat "${port_number}" 'AT' 2>&1)"
	echo "${response}" | grep -q 'OK'
}

run_mt5700_led_init()
{
	local elapsed at_port port_number response attempt at_ready restart_output

	[ -e "${DONE_FILE}" ] && return 0

	if ! is_bpi_r3_mini; then
		log_message info "Not a BPI-R3 Mini; skipping MT5700 LTE LED initialization"
		return 0
	fi

	if ! command -v sendat >/dev/null 2>&1; then
		log_message err "sendat is not installed"
		return 1
	fi

	elapsed=0
	at_port=""
	while [ "${elapsed}" -lt "${MAX_WAIT}" ]; do
		if is_mt5700_present; then
			at_port="$(find_mt5700_at_port)"
			[ -n "${at_port}" ] && break
		fi

		sleep 2
		elapsed=$((elapsed + 2))
	done

	if [ -z "${at_port}" ]; then
		log_message warning "MT5700M-CN or its AT port was not ready after ${MAX_WAIT} seconds"
		return 1
	fi

	case "${at_port}" in
		/dev/ttyUSB[0-9]*) port_number="${at_port#/dev/ttyUSB}" ;;
		*)
			log_message err "Unsupported MT5700 AT port: ${at_port}"
			return 1
			;;
	esac

	# Probe the AT channel once per second and stop after the first OK.
	attempt=1
	at_ready=0
	while [ "${attempt}" -le 10 ]; do
		response="$(timeout 2 sendat "${port_number}" "AT" 2>&1)"
		if echo "${response}" | grep -q "OK"; then
			at_ready=1
			log_message notice "AT channel ready on attempt ${attempt}"
			break
		fi
		attempt=$((attempt + 1))
		sleep 1
	done
	if [ "${at_ready}" -ne 1 ]; then
		log_message warning "MT5700 AT channel did not become ready"
		return 1
	fi
	[ -c "${at_port}" ] || {
		log_message warning "MT5700 AT port disappeared before LTE LED initialization"
		return 1
	}

	log_message notice "Sending AT+CFUN=0 through ${at_port}"
	response="$(timeout 10 sendat "${port_number}" 'AT+CFUN=0' 2>&1)"
	if ! echo "${response}" | grep -q 'OK'; then
		log_message err "AT+CFUN=0 failed: ${response}"
		return 1
	fi

	sleep 2

	log_message notice "Sending AT+CFUN=1 through ${at_port}"
	response="$(timeout 10 sendat "${port_number}" 'AT+CFUN=1' 2>&1)"
	if ! echo "${response}" | grep -q 'OK'; then
		log_message err "AT+CFUN=1 failed: ${response}"
		return 1
	fi

	# CFUN=0/1会重置MT5700的网络状态。等待AT通道恢复后，
	# 重新建立luci-app-modem的拨号任务和拨号日志。
	if [ -x /etc/init.d/modem ] &&
	   [ "$(uci -q get modem.@global[0].enable_dial)" = "1" ]; then
		elapsed=0
		response=""

		while [ "${elapsed}" -lt 30 ]; do
			if [ -c "${at_port}" ]; then
				response="$(timeout 2 sendat "${port_number}" 'AT' 2>&1)"
				echo "${response}" | grep -q 'OK' && break
			fi

			sleep 1
			elapsed=$((elapsed + 1))
		done

		if echo "${response}" | grep -q 'OK'; then
			sleep 2
			log_message notice "Restarting modem service after MT5700 CFUN cycle"

			if restart_output="$(/etc/init.d/modem restart 2>&1)"; then
				log_message notice "Modem service restarted after MT5700 CFUN cycle"
			else
				log_message err "Failed to restart modem service after MT5700 CFUN cycle: ${restart_output}"
			fi
		else
			log_message warning "AT channel did not recover; modem service restart skipped"
		fi
	fi

	# Publish readiness only after all ttyUSB1 users in this one-shot worker
	# have finished, including the optional modem service restart.
	if ! touch "${DONE_FILE}"; then
		log_message err "Failed to publish MT5700 initialization completion marker"
		return 1
	fi
	touch "${READY_FILE}"
	log_message notice "MT5700 LTE LED initialization completed"
}

run_worker()
{
	run_mt5700_led_init
}

start_service()
{
	# Let procd track the one-shot worker without delaying the boot sequence.
	procd_open_instance
	procd_set_param command /etc/init.d/sendat-cfun run_worker
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
